{
  "name": "staruml-mcp-server",
  "version": "1.0.0",
  "description": "Production-grade StarUML Model Context Protocol (MCP) Server for programmatically generating, arranging, and inspecting StarUML (.mdj) models.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "staruml-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "generate-sample": "tsx scripts/generate-complex-model.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "staruml",
    "mdj",
    "uml",
    "dagre",
    "claude",
    "ai-agent"
  ],
  "author": "Sebastián Quezada <quezadasebastian28@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quezadasebastian/staruml-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/quezadasebastian/staruml-mcp-server/issues"
  },
  "homepage": "https://github.com/quezadasebastian/staruml-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dagre": "^0.8.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.13.10",
    "lodash": "^4.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
